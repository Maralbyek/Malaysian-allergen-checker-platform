# Database (Docker MySQL)
# Using root user for migrations (has permission to create shadow database)
DATABASE_URL="mysql://root:rootpassword@localhost:3306/allergy_management"

# Better Auth
BETTER_AUTH_SECRET="change-this-to-a-secure-random-string-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (optional for demo)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (optional for demo)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
